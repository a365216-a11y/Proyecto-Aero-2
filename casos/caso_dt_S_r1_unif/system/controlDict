FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     rhoCentralFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         0.1;

deltaT          1e-9;
adjustTimeStep  yes;
maxCo           0.1;
maxDeltaT       1e-5;

writeControl    adjustableRunTime;
writeInterval   0.001;
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;

runTimeModifiable true;

functions
{
    gastoEntrada
    {
        type            surfaceFieldValue;
        libs            ("libfieldFunctionObjects.so");
        regionType      patch;
        name            inlet;
        operation       sum;
        fields          (phi);
        writeFields     no;
        writeControl    timeStep;
        writeInterval   10;
    }
    gastoSalida
    {
        $gastoEntrada;
        name            outlet;
    }
    salidaPresion
    {
        $gastoEntrada;
        name            outlet;
        operation       areaAverage;
        fields          (p T);
    }
    minMaxCampos
    {
        type            fieldMinMax;
        libs            ("libfieldFunctionObjects.so");
        mode            magnitude;
        fields          (U p T);
        writeControl    timeStep;
        writeInterval   10;
    }
}
