FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

5
(
    frontAndBack
    {
        type            patch;
        physicalType    patch;
        nFaces          5200;
        startFace       5050;
    }
    symmetry
    {
        type            patch;
        physicalType    patch;
        nFaces          130;
        startFace       10250;
    }
    wall
    {
        type            patch;
        physicalType    patch;
        nFaces          130;
        startFace       10380;
    }
    inlet
    {
        type            patch;
        physicalType    patch;
        nFaces          20;
        startFace       10510;
    }
    outlet
    {
        type            patch;
        physicalType    patch;
        nFaces          20;
        startFace       10530;
    }
)

